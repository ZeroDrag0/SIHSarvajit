# http  = read data from the backend (GET /api/...). Same origin: dev proxy (vite) or backend serving web/dist.
# static = read the pipeline files copied to public/data/schependomlaan (npm run sync:data), no backend needed.
VITE_DATA_MODE=http
# Only when the API is on a different origin, e.g. http://localhost:8000 (backend CORS must allow this origin).
VITE_API_BASE_URL=
